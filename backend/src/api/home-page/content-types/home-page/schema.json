          "localized": true
        }
      }
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [
        "blocks.hero-banner",
        "blocks.brand-intro",
        "blocks.service-highlights",
        "blocks.process-steps",
        "blocks.featured-destinations",
        "blocks.image-text",
        "blocks.testimonials-section",
        "blocks.faq-section",
        "blocks.contact-cta",
        "blocks.gallery-video",
        "blocks.multi-column",
        "blocks.rich-text"
      ],
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
