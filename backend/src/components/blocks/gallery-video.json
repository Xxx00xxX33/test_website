{
  "collectionName": "components_blocks_gallery_videos",
  "info": {
    "displayName": "Gallery / Video",
    "icon": "picture",
    "description": "Image gallery or video showcase block"
  },
  "attributes": {
    "heading": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "video": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "videoUrl": {
      "type": "string"
    },
    "layout": {
      "type": "enumeration",
      "enum": [
        "grid",
        "carousel",
        "masonry"
      ],
      "default": "grid"
    }
  }
}
