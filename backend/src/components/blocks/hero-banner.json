{
  "collectionName": "components_blocks_hero_banners",
  "info": {
    "displayName": "主横幅",
    "icon": "picture",
    "description": "全宽主横幅，含标题、副标题和行动按钮"
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "subtitle": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "backgroundImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "backgroundVideo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "videos"
      ]
    },
    "buttons": {
      "type": "component",
      "repeatable": true,
      "component": "shared.cta-button"
    },
    "overlayOpacity": {
      "type": "integer",
      "default": 40,
      "min": 0,
      "max": 100
    }
  }
}
